{
  "version": 1,
  "name": "Kriptografi drafting board",
  "source": "frontend/src/styles/tokens.css",
  "themes": {
    "dark": {
      "ground": "#0e0e0f",
      "ground-2": "#161618",
      "ground-3": "#1d1d20",
      "ink": "#f2f0e9",
      "ink-dim": "#a8a6a0",
      "ink-faint": "#6b6a66",
      "signal": "#ff5c00",
      "rule": "#3a3a3e",
      "rule-strong": "#5c5c62"
    },
    "light": {
      "ground": "#f4efe4",
      "ground-2": "#ebe5d6",
      "ground-3": "#e0d9c7",
      "ink": "#16130f",
      "ink-dim": "#5c554a",
      "ink-faint": "#8d8578",
      "signal": "#b23a1a",
      "rule": "#c4bba7",
      "rule-strong": "#8d8578"
    }
  },
  "radius": 0,
  "borders": {
    "default": "2px solid var(--rule-strong)",
    "heavy": "3px solid var(--ink)"
  },
  "shadow": "4px 4px 0",
  "fonts": {
    "prose": "Archivo",
    "mono": "JetBrains Mono"
  },
  "typeScale": {
    "micro": "0.6875rem",
    "small": "0.8125rem",
    "body": "0.9375rem",
    "lead": "1.125rem",
    "h3": "1.375rem",
    "h2": "2rem",
    "h1": "3.25rem"
  },
  "tracking": {
    "label": "0.16em"
  },
  "breakpoints": {
    "nav": "720px",
    "hero": "860px"
  }
}